{
  "name": "coliseum-english-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run build:runtime",
    "dev": "next dev",
    "prebuild": "npm run build:runtime",
    "build": "next build",
    "build:runtime": "esbuild ./runtime/entry.tsx --bundle --format=iife --global-name=ColiseumRuntime --platform=browser --target=es2020 --minify --outfile=public/lesson-runtime.js",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts tests/*.test.tsx",
    "test:auth": "tsx scripts/check-auth-flow.ts",
    "test:students": "tsx scripts/check-students-flow.ts",
    "test:admins": "tsx scripts/check-admins-flow.ts",
    "test:courses": "tsx scripts/check-courses-flow.ts",
    "test:lessons": "tsx scripts/check-lessons-flow.ts",
    "test:lesson-frame": "tsx scripts/check-lesson-frame.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "tsx scripts/check-db.ts",
    "seed:super-admin": "tsx scripts/seed-super-admin.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "argon2": "^0.44.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.7",
    "geist": "^1.7.2",
    "jose": "^6.1.0",
    "next": "^16.0.0",
    "postgres": "^3.4.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sucrase": "^3.35.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "^0.31.7",
    "esbuild": "0.25.12",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
