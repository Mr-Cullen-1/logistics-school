# Supabase Dashboard > Connect > Session pooler dagi URI ni aynan ko'chiring.
# Pooler hostini taxmin qilmang; port 5432 va username postgres.PROJECT_REF bo'ladi.
# Paroldagi @, #, %, ?, & kabi belgilarni URL-encode qiling.
# Haqiqiy qiymatni faqat .env ga yozing; bu namuna faylga maxfiy parol qo'ymang.
DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
